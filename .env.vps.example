# VPS: copy to .env next to docker-compose.vps.yml and fill the key. Never commit .env.
# docker-compose.vps.yml sets APP_ENV=vps and DATABASE_URL (host `db`, port not published)
# for the app container; run DB tools inside it: docker compose -f docker-compose.vps.yml exec app ...
APP_ENV=vps

# OCR on CPU servers goes through the LLM API (src/llm/tasks/ocr_label.yaml → QWEN_API_KEY).
QWEN_API_KEY=sk-ws-replace-me

# Optional overrides for docker-compose.vps.yml
# VINE_PORT=80
# VINE_IMAGE=vine-scanner:cpu
# VINE_PG_VOLUME=vine_vps_pgdata
# VINE_LOG_LEVEL=INFO
