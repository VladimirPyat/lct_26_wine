# Build context = code + config only. Models, data and catalog images are mounted at runtime
# (docker-compose.full.yml), never baked into the image.
.git
.gitignore
.worktrees/
.trash/
_migration/
_data
_out
.venv/
.cursor/
.idea/
.gigaide/
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache

# secrets
.env
*.pem
*.key
credentials.json
service-account*.json

# large / runtime trees (mounted)
bin/
data/
static/wines/
db/

# docs and agent artefacts (not needed at runtime)
docs/
agent_docs/
manuals/
tests/
csv
*.log
*.sql
*.sqlite
