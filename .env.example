# Copy to .env and adjust. Never commit .env.

# App on host talking to Compose-published Postgres:
DATABASE_URL=postgresql+psycopg://vine:vine@127.0.0.1:5432/vine

# App service inside Compose network would use hostname `db` instead of 127.0.0.1:
# DATABASE_URL=postgresql+psycopg://vine:vine@db:5432/vine

# Config profile: dev (base config/*.yaml) | vps (+ overlays from config/profiles/vps/).
# VPS template: .env.vps.example
# APP_ENV=dev

# LLM API keys only (base_url / model / retries live in src/llm/tasks/*.yaml)
QWEN_API_KEY=sk-ws-replace-me
OPENAI_API_KEY=sk-replace-me
