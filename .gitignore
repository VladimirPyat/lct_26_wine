# big data (catalog source CSVs are tracked; images / eval / tmp are not)
/data/*
!/data/wines_integrated_updated.csv
!/data/wines_problem_images.csv
!/data/site_database/
/data/site_database/*
!/data/site_database/wines_database_enriched.json
bin/
# Top-level FAISS/vector dump dir (not src/db package)
/db/

# eval report binaries (query crops, embedding caches) — regenerated by scripts
agent_docs/reports/**/*.jpg
agent_docs/reports/**/*.jpeg
agent_docs/reports/**/*.png
agent_docs/reports/**/*.webp
agent_docs/reports/**/*_query_crops/
agent_docs/reports/**/*.npz

# catalog images served by API (regenerated by import)
static/wines/*
!static/wines/.gitkeep

